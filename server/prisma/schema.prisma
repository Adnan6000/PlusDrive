generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String
  
  // FIX: Added missing 'surname' field
  surname   String?
  
  role      String   @default("STUDENT") 
  
  // Settings & Profile
  autoConfirm     Boolean @default(false)
  phone           String?
  address         String?
  city            String?    // Added for completeness
  zipCode         String?    // Added for completeness
  country         String?  @default("Denmark")
  
  // Authentication & Access
  isVerified      Boolean  @default(false)
  verificationToken String?
  resetToken      String?
  resetTokenExpiry DateTime?
  hasTheoryAccess Boolean  @default(false)

  // Relations
  schoolId         String?
  school           School?       @relation(fields: [schoolId], references: [id])
  bookings         Booking[]     @relation("StudentBookings")
  adminBookings    Booking[]     @relation("AdminBookings")
  availabilities   Availability[] 
  sentMessages     Message[]     @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Availability {
  id        String   @id @default(uuid())
  adminId   String
  date      DateTime
  startTime String   
  endTime   String   
  isBooked  Boolean  @default(false)
  
  admin     User     @relation(fields: [adminId], references: [id])
  booking   Booking?
}

model Booking {
  id                String   @id @default(uuid())
  availabilityId    String   @unique
  status            String   @default("PENDING") 
  date              DateTime
  startTime         String
  endTime           String
  type              String   @default("Driving")
  attendance        String   @default("PENDING") 
  note              String?

  studentId         String
  student           User     @relation("StudentBookings", fields: [studentId], references: [id])
  
  adminId           String
  admin             User     @relation("AdminBookings", fields: [adminId], references: [id])
  availability      Availability  @relation(fields: [availabilityId], references: [id])

  createdAt         DateTime @default(now())
}

model School {
  id        String   @id @default(uuid())
  name      String
  users     User[]
}

model Message {
  id        String   @id @default(uuid())
  content   String?
  
  senderId  String
  sender    User     @relation("SentMessages", fields: [senderId], references: [id])
  
  receiverId String
  receiver   User    @relation("ReceivedMessages", fields: [receiverId], references: [id])
  
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  attachmentUrl String?
  attachmentType  String?

  isDeletedEveryone   Boolean   @default(false)
  deletedBySender     Boolean   @default(false)
  deletedByReceiver   Boolean   @default(false)
}

model Lesson {
  id        String   @id @default(uuid())
  title     String
  content   String   // Description or study notes
  videoUrl  String?  // YouTube link
  category  String   // "Car" or "Motorcycle"
  createdAt DateTime @default(now())
}